# Database Configuration
# DB_CONN_MAX_AGE: Maximum time (in seconds) database connections remain open
# Set to 0 to close connections after each request (default, not recommended for production)
# Set to 600 (10 minutes) for production to enable connection pooling
DB_CONN_MAX_AGE=0

# Cache Configuration
CACHE_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_URL=smtp://localhost:1025

# Security
SECRET_KEY=changeme

# Development Settings
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True
DASHBOARD_URL=http://localhost:9000/

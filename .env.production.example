# DigitalOcean Deployment Configuration
# Copy this file to .env.production and fill in your values

# Domain Configuration
DOMAIN_NAME=your-domain.com

# Database Configuration
POSTGRES_DB=saleor
POSTGRES_USER=saleor
POSTGRES_PASSWORD=your-secure-password-here

# Django Configuration
SECRET_KEY=your-secret-key-here-use-strong-random-string
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DEBUG=False

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@your-domain.com
EMAIL_URL=smtp://username:password@smtp.gmail.com:587/?tls=True

# Frontend Configuration
NEXT_PUBLIC_SALEOR_API_URL=https://your-domain.com/graphql/
NEXT_PUBLIC_STOREFRONT_URL=https://your-domain.com
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Optional: AWS S3 for media storage (recommended for production)
AWS_MEDIA_BUCKET_NAME=
AWS_MEDIA_CUSTOM_DOMAIN=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployment Options
CREATE_SUPERUSER=false  # Set to true on first deployment
POPULATE_DB=false       # Set to true to populate with sample data

# Superuser Configuration (only if CREATE_SUPERUSER=true)
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=your-admin-password

# Optional: Monitoring
JAEGER_AGENT_HOST=

# Optional: Sentry for error tracking
SENTRY_DSN=

# DigitalOcean Deployment Configuration
# Copy this file to .env.production and fill in your values

# Domain Configuration
DOMAIN_NAME=your-domain.com

# Database Configuration
POSTGRES_DB=saleor
POSTGRES_USER=saleor
POSTGRES_PASSWORD=your-secure-password-here

# Database Connection Pooling (RECOMMENDED for production)
# Keep connections open for 10 minutes to reduce overhead
DB_CONN_MAX_AGE=600

# Django Configuration
SECRET_KEY=your-secret-key-here-use-strong-random-string
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DEBUG=False

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@your-domain.com
EMAIL_URL=smtp://username:password@smtp.gmail.com:587/?tls=True

# Frontend Configuration
NEXT_PUBLIC_SALEOR_API_URL=https://your-domain.com/graphql/
NEXT_PUBLIC_STOREFRONT_URL=https://your-domain.com
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Optional: AWS S3 for media storage (recommended for production)
AWS_MEDIA_BUCKET_NAME=
AWS_MEDIA_CUSTOM_DOMAIN=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployment Options
CREATE_SUPERUSER=false  # Set to true on first deployment
POPULATE_DB=false       # Set to true to populate with sample data

# Superuser Configuration (only if CREATE_SUPERUSER=true)
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=your-admin-password

# Performance Optimization
# Celery worker settings for better performance
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_ACKS_LATE=True
CELERY_WORKER_PREFETCH_MULTIPLIER=4

# Cache timeout (in seconds) - 7 days default
CACHE_TIMEOUT=604800

# Security Settings (Production)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Optional: Monitoring
JAEGER_AGENT_HOST=

# Optional: Sentry for error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=saleor-api
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Environment files - NEVER commit these!
.env
.env.local
.env.*.local
.env.production
*.env
!.env.example
!.env.production.example

# Python
*.py[cod]
*.pyo
*.pyd
__pycache__/
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.pnpm-debug.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Media & Static files
/media/
/static/
/saleor/media/
/saleor/static/

# Docker
.dockerignore

# SSL Certificates (these should be generated, not committed)
*.pem
*.key
*.crt
/nginx/ssl/*.pem
/nginx/ssl/*.key

# Build outputs
/storefront/.next/
/storefront/out/
/storefront/build/

# Testing
coverage/
.coverage
htmlcov/
/test-results/
/playwright-report/

# Temporary files
*.tmp
*.temp
.cache/

# OS
Thumbs.db
.DS_Store

# Backup files
*.bak
*.backup
*~

# Local configuration overrides
docker-compose.override.yml
docker-compose.local.yml

# Secrets and credentials
secrets/
credentials/
*.credentials

# Keep example files
!*.example
!*-example.*

{
	"name": "saleor-storefront",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "BSD-3-Clause",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"predev": "pnpm run generate",
		"prebuild": "pnpm run generate",
		"lint": "eslint",
		"generate": "graphql-codegen --config .graphqlrc.ts",
		"prepare": "husky install",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:integration": "jest --config=jest.integration.config.cjs",
		"test:integration:watch": "jest --config=jest.integration.config.cjs --watch",
		"test:integration:api": "jest --config=jest.integration.config.cjs api",
		"test:integration:auth": "jest --config=jest.integration.config.cjs auth",
		"test:integration:cart": "jest --config=jest.integration.config.cjs checkout",
		"test:integration:catalog": "jest --config=jest.integration.config.cjs catalog",
		"test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:report": "playwright show-report",
		"test:e2e:home": "playwright test home-page",
		"test:e2e:product": "playwright test product-page",
		"test:e2e:browsing": "playwright test product-browsing",
		"test:e2e:cart": "playwright test cart-checkout",
		"test:e2e:auth": "playwright test authentication",
		"test:e2e:account": "playwright test account-management",
		"test:e2e:wishlist": "playwright test wishlist-comparison",
		"test:e2e:gamification": "playwright test gamification",
		"test:e2e:mobile": "playwright test product-page-mobile mobile-workflows",
		"test:e2e:visual": "playwright test product-page-visual",
		"test:e2e:core": "playwright test home-page product-page product-browsing cart-checkout",
		"test:e2e:all": "playwright test --grep-invert @skip"
	},
	"dependencies": {
		"@adyen/adyen-web": "5.53.3",
		"@adyen/api-library": "15.0.0-beta",
		"@headlessui/react": "1.7.18",
		"@saleor/auth-sdk": "1.0.3",
		"@stripe/react-stripe-js": "3.7.0",
		"@stripe/stripe-js": "7.3.0",
		"@tailwindcss/container-queries": "0.1.1",
		"clsx": "2.1.0",
		"editorjs-html": "3.4.3",
		"formik": "2.4.5",
		"libphonenumber-js": "1.10.58",
		"lodash-es": "4.17.21",
		"lucide-react": "0.358.0",
		"next": "16.0.10",
		"query-string": "8.1.0",
		"react": "^19.1.2",
		"react-dom": "^19.1.2",
		"react-error-boundary": "4.0.13",
		"react-spinners": "0.13.8",
		"react-test-renderer": "18.2.0",
		"react-toastify": "^11.0.0",
		"sharp": "0.33.2",
		"ts-invariant": "0.10.3",
		"url-join": "5.0.0",
		"urql": "4.0.6",
		"xss": "1.0.15",
		"yup": "1.3.2",
		"zustand": "4.4.6"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "5.0.0",
		"@graphql-codegen/client-preset": "4.1.0",
		"@graphql-typed-document-node/core": "3.2.0",
		"@next/env": "16.0.7",
		"@parcel/watcher": "2.3.0",
		"@playwright/test": "1.57.0",
		"@tailwindcss/forms": "0.5.7",
		"@tailwindcss/typography": "0.5.10",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.1",
		"@testing-library/user-event": "14.6.1",
		"@types/jest": "30.0.0",
		"@types/lodash-es": "4.17.12",
		"@types/node": "20.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/url-join": "4.0.3",
		"@typescript-eslint/eslint-plugin": "8.48.1",
		"@typescript-eslint/parser": "8.48.1",
		"autoprefixer": "10.4.16",
		"eslint": "9.39.1",
		"eslint-config-next": "16.0.7",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-import": "2.32.0",
		"graphql-tag": "2.12.6",
		"husky": "8.0.3",
		"jest": "30.2.0",
		"jest-environment-jsdom": "30.2.0",
		"lint-staged": "15.1.0",
		"postcss": "8.4.32",
		"prettier": "3.1.1",
		"prettier-plugin-tailwindcss": "0.5.9",
		"schema-dts": "1.1.2",
		"tailwindcss": "3.4.0",
		"typescript": "5.3.3",
		"wonka": "6.3.4"
	},
	"resolutions": {
		"graphql": "16.8.1"
	},
	"packageManager": "pnpm@9.6.0",
	"engines": {
		"pnpm": ">=9.4.0",
		"node": ">=18"
	}
}
